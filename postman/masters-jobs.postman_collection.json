        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{home_culture}}/backend/auth/login",
          "host": [
            "{{home_culture}}"
          ],
          "path": [
            "backend",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json().data || {};",
              "const t = d.token || d.accessToken;",
              "if (t) pm.collectionVariables.set('authToken', t);"
            ]
          }
        }
      ]
    },
